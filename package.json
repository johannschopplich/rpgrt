{
  "name": "rpgrt",
  "type": "module",
  "version": "0.2.0",
  "packageManager": "pnpm@11.20.0",
  "description": "Turn RPG Maker 2000/2003 games into diffable JSON and back – byte for byte, in pure TypeScript",
  "author": "Johann Schopplich <hello@johannschopplich.com>",
  "license": "MIT",
  "homepage": "https://github.com/johannschopplich/rpgrt#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johannschopplich/rpgrt.git"
  },
  "bugs": {
    "url": "https://github.com/johannschopplich/rpgrt/issues"
  },
  "keywords": [
    "lcf",
    "rpg-maker-2000",
    "rpg-maker-2003",
    "easyrpg",
    "lmu",
    "ldb",
    "lmt",
    "translation",
    "cli"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./encoding": {
      "types": "./dist/encoding.d.mts",
      "default": "./dist/encoding.mjs"
    }
  },
  "types": "./dist/index.d.mts",
  "bin": {
    "rpgrt": "bin/rpgrt.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node src/entry.ts",
    "build": "tsdown",
    "generate": "node scripts/generate.ts",
    "make-fixtures": "node scripts/make-fixtures.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:types": "tsc --noEmit",
    "release": "bumpp"
  },
  "dependencies": {
    "ansis": "^4.3.1",
    "chardet": "^2.2.0",
    "citty": "^0.2.2",
    "iconv-lite": "^0.7.3",
    "uint8array-extras": "^1.5.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.2.0",
    "@types/node": "^26.1.2",
    "bumpp": "^12.1.1",
    "eslint": "^10.8.0",
    "eslint-flat-config-utils": "^3.2.0",
    "fast-check": "^4.9.0",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
